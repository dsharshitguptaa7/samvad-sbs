# ==============================================================================
# SAMVAD Environment Configuration Template (.env.example)
# School of Basic Sciences, CSJMU Kanpur
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in your actual Neon PostgreSQL connection strings and session secret.
# 3. NEVER commit .env.local or real secrets to version control.
# 4. NEVER prefix database credentials with NEXT_PUBLIC_* as that exposes them to client browsers.
#
# ==============================================================================
# 1. NEON POSTGRESQL CONFIGURATION
# ==============================================================================

# DATABASE_URL:
# Pooled connection string utilizing pgBouncer transaction pooling.
# Used by Next.js Server Components and Server Actions during runtime.
# Example format:
# postgresql://[user]:[password]@[neon-project-id]-pooler.ap-south-1.aws.neon.tech/[dbname]?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://neondb_owner:npg_TIS8Eqy6AQaX@ep-billowing-wind-b39aytse-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# DIRECT_URL:
# Direct unpooled connection string (bypasses pgBouncer).
# Mandatory for Prisma CLI migrations (prisma migrate dev / deploy) because
# migration locks and DDL execution require session-level connection features.
# Example format:
# postgresql://[user]:[password]@[neon-project-id].ap-south-1.aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-samvad.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# 2. SESSION & AUTHENTICATION SECURITY
# ==============================================================================

# Cryptographically strong 64-character secret used to sign secure HTTP-only cookies.
# Generate via: openssl rand -base64 48
SESSION_SECRET="REPLACE_WITH_A_64_CHARACTER_CRYPTOGRAPHICALLY_RANDOM_SECRET_STRING"

# ==============================================================================
# 3. ENVIRONMENT MODE
# ==============================================================================
NODE_ENV="development"
